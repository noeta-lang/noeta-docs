{
  // noeta-docs Worker — served at docs.noeta.dev. A static-assets Worker: the
  // Astro build output in dist/ is served directly by Cloudflare (no Worker
  // script).
  //   pnpm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noeta-docs",
  "compatibility_date": "2025-07-01",
  // Custom domain: wrangler manages the DNS record itself — do not add a CNAME by hand.
  "routes": [{ "pattern": "docs.noeta.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
