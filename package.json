{
  "name": "noeta-docs",
  "version": "0.1.0",
  "private": true,
  "description": "The Noeta project & language documentation site — docs.noeta.dev.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "prebuild": "node scripts/sync-docs.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/build-og-image.mjs",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@noeta/theme": "file:../noeta-theme"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.9",
    "astro-pagefind": "^2.0.1",
    "playwright-core": "^1.61.1",
    "rehype-slug": "^6.0.0",
    "typescript": "^5.9.3",
    "wrangler": "~4.112.0"
  }
}
