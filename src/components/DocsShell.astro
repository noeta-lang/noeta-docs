---
/* Docs chrome: sidebar (pagefind search + _Sidebar.md nav), the page-contents
 * rail, the article body (slot — Astro's <Content />), updated-on,
 * edit-on-GitHub, and prev/next paging. Slugs live at the site root: Home at /,
 * others at /<slug>. */
import Search from "astro-pagefind/components/Search.astro";
import Base from "../layouts/Base.astro";
import { getSidebar, getSidebarLinks, getParaLib, getStdModule } from "../lib/docs.mjs";
import { listDocs } from "../../scripts/docs-meta.mjs";
import { SITE } from "../lib/site";
import type { MarkdownHeading } from "astro";

interface Props {
  slug: string;
  sourcePath: string;
  title: string;
  headings: MarkdownHeading[];
}
const { slug, sourcePath, title, headings } = Astro.props;

// Page contents. h2/h3 only: h1 is the page title (it is already the <title>
// and the active sidebar row), and h4 is a mono label inside a section rather
// than somewhere you navigate to. These slugs are Astro's; the ids in the
// rendered HTML are rehype-slug's. They agree today — and check-links.mjs
// checks every one of these fragments against the built page, so if they ever
// stop agreeing the build fails instead of the reader's click.
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug && h.text.trim());
// One entry is not a table of contents, it is a link into the middle of the page.
const showToc = toc.length > 1;

// h3s nest under the h2 they belong to, so the rail can show the sections and
// only expand the one being read — std.http has 86 headings, and a flat list of
// them is a wall, not a map. A page whose first headings are h3s (no h2 above
// them) keeps them at the top level rather than inventing a parent.
const tocGroups: { heading: (typeof toc)[number]; children: typeof toc }[] = [];
for (const h of toc) {
  const top = tocGroups[tocGroups.length - 1];
  if (h.depth === 2 || !top) tocGroups.push({ heading: h, children: [] });
  else top.children.push(h);
}

const sidebar = getSidebar();
const links = getSidebarLinks();
const idx = links.findIndex((l) => l.slug === slug);
const prev = idx > 0 ? links[idx - 1] : null;
const next = idx >= 0 && idx < links.length - 1 ? links[idx + 1] : null;

const path = slug === "home" ? "/" : `/${slug}`;
// Para-library pages mirror a repo's README (or, for the overview, a template
// in this repo — its manifest entry carries the edit URL outright); std pages
// are generated, so their edit link points at the intrinsic doc prose;
// everything else lives in the noeta repo's docs/.
const para = getParaLib(slug);
const std = getStdModule(slug);
const editUrl = para
  ? (para.edit ?? `https://github.com/${para.org}/${para.repo}/edit/${para.branch}/README.md`)
  : (std?.edit ?? `https://github.com/${SITE.docsRepo}/edit/${SITE.docsBranch}/docs/${sourcePath}.md`);

const info = listDocs().find((d) => d.slug === slug);
const description = info?.description || undefined;
const datePublished = info?.datePublished ?? new Date().toISOString();
const dateModified = info?.dateModified ?? datePublished;

const pageTitle = slug === "home" ? SITE.title : `${title} — Noeta Docs`;
const formatDate = (iso: string) => iso.slice(0, 10);
---

<Base
  title={pageTitle}
  description={description}
  path={path}
  article={{ headline: title, datePublished, dateModified }}
>
  <main class="wrap docs-grid">
    <aside class="docs-sidebar">
      <button
        type="button"
        class="docs-search-trigger"
        id="docs-search-open"
        aria-haspopup="dialog"
        aria-controls="docs-search-dialog"
      >
        <svg class="dss-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="dss-label">Search the docs…</span>
        <kbd class="dss-key">/</kbd>
      </button>
      <dialog class="docs-search-dialog" id="docs-search-dialog" aria-label="Search the docs">
        <Search
          className="docs-search"
          searchboxOptions={{ placeholder: "Search the docs…", shortcut: "false" }}
        />
      </dialog>
      <script>
        // Trigger-as-input opens a modal search; "/" opens it too (unless already typing in a
        // field), Escape/backdrop close it. The pagefind-searchbox's own shortcut is disabled
        // (shortcut="false") so this is the single entry point.
        const openBtn = document.getElementById("docs-search-open");
        const dialog = document.getElementById("docs-search-dialog");
        if (openBtn && dialog instanceof HTMLDialogElement) {
          const focusInput = () =>
            requestAnimationFrame(() => dialog.querySelector("input")?.focus());
          const open = () => {
            if (!dialog.open) {
              dialog.showModal();
              focusInput();
            }
          };
          openBtn.addEventListener("click", open);
          document.addEventListener("keydown", (event) => {
            if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
            const target = event.target as HTMLElement | null;
            const tag = target?.tagName;
            if (tag === "INPUT" || tag === "TEXTAREA" || target?.isContentEditable) return;
            if (dialog.open) return;
            event.preventDefault();
            open();
          });
          // Click on the backdrop (the dialog element itself, outside the panel) closes it.
          dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
          });
        }
      </script>
      <!-- Ships `open` so desktop and no-JS readers always get the full tree. Two
           things narrow it: the script below collapses it to its <summary> under
           56rem, and under 38rem the shared chrome drawer moves it in wholesale
           (data-drawer-content) so the site links and the contents tree are one
           menu rather than two. -->
      <details class="docs-nav" data-drawer-content open>
        <summary>Contents</summary>
        <nav aria-label="Documentation">
          <ul>
            {
              sidebar.map((entry) =>
                entry.kind === "section" ? (
                  <li class="docs-section-label">{entry.title}</li>
                ) : entry.children.length > 0 ? (
                  <li>
                    {/* A collapsible group: the parent link doubles as the summary row.
                        Open only when the reader is inside the group — collapsed groups
                        keep the long generated sections to a single row. Clicking the
                        link navigates (the toggle is moot mid-navigation); the chevron
                        area toggles without leaving the page. */}
                    <details
                      class="docs-group"
                      open={entry.slug === slug || entry.children.some((c) => c.slug === slug)}
                    >
                      <summary>
                        <a href={entry.path} class={entry.slug === slug ? "active" : undefined}>
                          {entry.title}
                        </a>
                      </summary>
                      <ul>
                        {entry.children.map((child) => (
                          <li>
                            <a href={child.path} class={child.slug === slug ? "active" : undefined}>
                              {child.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a href={entry.path} class={entry.slug === slug ? "active" : undefined}>
                      {entry.title}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </nav>
      </details>
      <script is:inline>
        // Below 56rem the contents tree is ~2000px tall and pushes the article
        // title roughly two and a half screens down, so collapse it there; the
        // <summary> toggle only renders below that breakpoint (docs.css), which
        // is also why it has to stay open above it. Inline rather than a bundled
        // module so it runs before first paint — deferred, the expanded tree
        // flashes in and the page jumps.
        (() => {
          const nav = document.querySelector("details.docs-nav");
          if (!nav) return;
          const compact = window.matchMedia("(max-width: 56rem)");
          const sync = () => {
            nav.open = !compact.matches;
          };
          sync();
          compact.addEventListener("change", sync);
        })();
      </script>
      <script is:inline>
        // Bring the active link into view on arrival — the tree is long, and a
        // deep link (a std module, an internals page) otherwise lands with the
        // highlighted item below the sidebar's own fold. Centered, not
        // scrollIntoView: the latter also scrolls the page itself. Inline for
        // the same no-flash reason as above. No-op when the sidebar doesn't
        // scroll (mobile's static layout, short trees).
        (() => {
          const box = document.querySelector(".docs-sidebar");
          const active = box && box.querySelector(".docs-nav a.active");
          if (!box || !active || box.scrollHeight <= box.clientHeight) return;
          const offset = active.getBoundingClientRect().top - box.getBoundingClientRect().top;
          box.scrollTop += offset - box.clientHeight / 2;
        })();
      </script>
    </aside>

    {
      showToc && (
        /* Page contents. Above --bp-rail (78rem) this is the sticky right-hand
           rail and the summary is just its label; below it the same element is a
           collapsed disclosure sitting above the article, because a third column
           has nowhere to go. Ships `open` so a no-JS reader gets the list in
           either layout; the script below closes it in the narrow one. */
        <details class="docs-toc" open>
          <summary>On this page</summary>
          <nav aria-label="On this page">
            <ul>
              {tocGroups.map((group) => (
                <li class={group.heading.depth === 3 ? "toc-sub" : undefined}>
                  <a href={`#${group.heading.slug}`}>{group.heading.text}</a>
                  {group.children.length > 0 && (
                    <ul>
                      {group.children.map((child) => (
                        <li class="toc-sub">
                          <a href={`#${child.slug}`}>{child.text}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )
    }

    <article class="docs-article" data-pagefind-body>
      <header class="docs-article-head" data-pagefind-ignore>
        <time class="ts" datetime={dateModified}>Updated {formatDate(dateModified)}</time>
      </header>

      <div class="prose docs-prose"><slot /></div>

      <footer class="docs-article-foot" data-pagefind-ignore>
        <a href={editUrl} class="edit-link" target="_blank" rel="noopener">Edit on GitHub →</a>
      </footer>

      {
        (prev || next) && (
          <nav class="docs-pager" aria-label="Documentation pagination" data-pagefind-ignore>
            {prev ? (
              <a href={prev.path} class="pager-link pager-prev">
                <span class="pager-dir">← Previous</span>
                <span class="pager-title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a href={next.path} class="pager-link pager-next">
                <span class="pager-dir">Next →</span>
                <span class="pager-title">{next.title}</span>
              </a>
            ) : null}
          </nav>
        )
      }
    </article>

    <script is:inline>
      // Collapse the contents list below --bp-rail (78rem), where it is a
      // disclosure above the article rather than a rail beside it — on a
      // reference page it is eighty rows and would bury the prose. Inline
      // rather than a bundled module for the same reason as the sidebar's:
      // deferred, the open list paints first and the page jumps. And as there,
      // CSS cannot force a closed <details> open, so the wide layout needs this
      // script to reopen it.
      (() => {
        const box = document.querySelector("details.docs-toc");
        if (!box) return;
        const inline = window.matchMedia("(max-width: 78rem)");
        const sync = () => {
          box.open = !inline.matches;
        };
        sync();
        inline.addEventListener("change", sync);
      })();
    </script>
    <script is:inline>
      // Scroll-spy: mark the section the reader is actually in. Placed after the
      // article so the heading elements exist when it runs.
      //
      // Position, not IntersectionObserver: an observer band leaves nothing
      // active whenever a section is taller than the viewport, which on these
      // pages is most of them. This asks instead which heading was the last to
      // cross the reading line just under the sticky header — always exactly one
      // answer, and the same answer the reader would give.
      (() => {
        const box = document.querySelector("details.docs-toc");
        if (!box) return;
        const targets = [...box.querySelectorAll("a[href^='#']")]
          .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
          .filter((t) => t.el);
        if (targets.length < 2) return;

        const head = document.querySelector(".site-head");
        let active = null;
        let openGroup = null;

        // Collapse the sub-sections down to the one being read. Set from script,
        // so a reader without JS still gets the whole list rather than a rail
        // that hides most of itself and never expands. The rail styles honour
        // it; the folded disclosure ignores it, since opening that one is
        // already a deliberate "show me everything".
        box.dataset.grouped = "";

        const mark = (next) => {
          if (next === active) return;
          if (active) {
            active.a.classList.remove("active");
            active.a.removeAttribute("aria-current");
          }
          active = next;
          // Expand the group the active row belongs to — closest() walks up to
          // the outermost <li>, so an h3 opens its own h2's group.
          const group = active ? active.a.closest(".docs-toc > nav > ul > li") : null;
          if (group !== openGroup) {
            if (openGroup) openGroup.classList.remove("current");
            if (group) group.classList.add("current");
            openGroup = group;
          }
          if (!active) return;
          active.a.classList.add("active");
          active.a.setAttribute("aria-current", "true");
          // A long list scrolls inside the rail; keep the active row visible
          // there without touching the page's own scroll position. Measured
          // after the group above expanded, so the row's position is final.
          if (box.scrollHeight > box.clientHeight) {
            const row = active.a.getBoundingClientRect();
            const rail = box.getBoundingClientRect();
            if (row.top < rail.top + 8) box.scrollTop += row.top - rail.top - 8;
            else if (row.bottom > rail.bottom - 8) box.scrollTop += row.bottom - rail.bottom + 8;
          }
        };

        const update = () => {
          const line = (head ? head.getBoundingClientRect().bottom : 0) + 24;
          let current = null;
          for (const t of targets) {
            if (t.el.getBoundingClientRect().top > line) break;
            current = t;
          }
          // At the bottom of the page the last section is the one being read
          // even if its heading never reached the line — a short final section
          // otherwise leaves the previous one highlighted for good.
          const doc = document.documentElement;
          if (window.innerHeight + window.scrollY >= doc.scrollHeight - 2) {
            current = targets[targets.length - 1];
          }
          mark(current);
        };

        let queued = false;
        const schedule = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            update();
          });
        };

        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule);
        update();
      })();
    </script>
  </main>
</Base>
