---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Noeta Docs" description="That page does not exist." path="/404">
  <main class="wrap docs-404">
    <p class="eyebrow reveal" style="--d: 0">E0404</p>
    <h1 class="reveal" style="--d: 1">This page is <span class="accent">unrepresentable.</span></h1>
    <p class="dek reveal" style="--d: 2">The doc you asked for doesn't exist. Head back to the start.</p>
    <div class="cta-row reveal" style="--d: 3">
      <a class="btn btn-primary" href="/">← docs home</a>
    </div>
  </main>
</Base>
