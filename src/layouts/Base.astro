---
/* Page shell: the shared @noeta/theme (fonts + tokens + chrome), this site's
 * docs styles, head, header/footer, and the fixed atmospheric background. */
import "@noeta/theme/fonts.css";
import "@noeta/theme/theme.css";
import "../styles/docs.css";
import BaseHead from "../components/BaseHead.astro";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  article?: { headline: string; datePublished: string; dateModified: string };
}

const { title, description, path, article } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path={path} article={article} />
  </head>
  <body>
    <div class="field" aria-hidden="true"></div>
    <header class="site-head">
      <div class="wrap">
        <a class="wordmark" href="/">noeta<span class="tld">.dev/docs</span></a>
        <nav class="site-nav" aria-label="Site">
          <a href={SITE.links.home}>noeta.dev</a>
          <a href={SITE.links.registry}>registry</a>
          <a href={SITE.links.playground}>playground</a>
          <a href={SITE.links.github}>github</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-foot">
      <div class="wrap">
        <span class="tagline">AI-native, <em>human-first.</em></span>
        <nav class="foot-nav" aria-label="Footer">
          <a href={SITE.links.home}>noeta.dev</a>
          <a href={SITE.links.registry}>registry</a>
          <a href={SITE.links.playground}>playground</a>
          <a href={SITE.links.github}>github</a>
        </nav>
        <p class="foot-meta">
          Noeta is pre-alpha and built in the open — anything may change without notice.
        </p>
      </div>
    </footer>
  </body>
</html>
