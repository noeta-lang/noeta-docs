---
/* Page shell: the shared @noeta/theme (fonts + tokens + chrome), this site's
 * docs styles, head, header/footer, and the fixed atmospheric background. */
import "@noeta/theme/fonts.css";
import "@noeta/theme/theme.css";
import "../styles/docs.css";
import BaseHead from "../components/BaseHead.astro";
import { renderHeader, renderFooter, DRAWER_SCRIPT } from "@noeta/theme/chrome";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  article?: { headline: string; datePublished: string; dateModified: string };
}

const { title, description, path, article } = Astro.props;
---

<!doctype html>
<!-- data-layout="wide" takes the theme's --max from the 72rem reading width to
     84rem, which is what makes room for the third column (nav · article · page
     contents). It goes on <html>, not on the page body, so the shared header and
     footer — .wrap elements the theme renders — widen with it and everything
     stays on one left edge. -->
<html lang="en" data-layout="wide">
  <head>
    <BaseHead title={title} description={description} path={path} article={article} />
  </head>
  <body>
    <div class="field" aria-hidden="true"></div>
    <Fragment set:html={renderHeader({ site: "docs", version: SITE.version })} />
    <slot />
    <Fragment set:html={renderFooter({ site: "docs" })} />
    <script is:inline set:html={DRAWER_SCRIPT} />
  </body>
</html>
